{
  "name": "health-mcp-cloudrun",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Single-user Google Health API v4 MCP server on Cloud Run — read-only, tokens in Firestore, identity/location redaction.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "node --test test/*.test.mjs",
    "deploy": "gcloud run deploy health-mcp --source . --region us-central1"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3"
  }
}
