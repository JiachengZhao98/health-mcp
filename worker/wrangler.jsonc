{
  // health-mcp — single-user Google Health MCP server on Cloudflare Workers (free plan).
  "name": "health-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,

  // Created with: npx wrangler kv namespace create TOKENS
  // Paste the id it prints below, then deploy.
  "kv_namespaces": [
    { "binding": "TOKENS", "id": "PASTE_KV_NAMESPACE_ID_HERE" }
  ],

  "observability": { "enabled": true }

  // Secrets (never put these in this file):
  //   npx wrangler secret put GH_CLIENT_ID
  //   npx wrangler secret put GH_CLIENT_SECRET
  //   npx wrangler secret put SECRET_PATH     ← openssl rand -hex 32
}
